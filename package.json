{
  "name": "@proxima/site-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Proxima navigation and footer components",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
