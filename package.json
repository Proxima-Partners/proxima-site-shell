{
  "name": "@proxima/site-shell",
  "version": "0.4.0",
  "private": true,
  "description": "Shared Proxima header, Give menu, section bar and footer for every page at liveproxima.org, built from the Brand System release",
  "type": "module",
  "files": [
    "dist",
    "brand",
    "brand.lock.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "test": "npm run build && node scripts/check-brand.mjs && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
