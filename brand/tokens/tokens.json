{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Proxima Brand System",
    "version": "2.3.0",
    "status": "approved",
    "approvedDate": "2026-10-11"
  },
  "color": {
    "teal": { "$type": "color", "$value": "#05718D" },
    "goldenrod": { "$type": "color", "$value": "#EEB11E" },
    "mauve": { "$type": "color", "$value": "#C369C9" },
    "flame": { "$type": "color", "$value": "#E4572E" },
    "black": { "$type": "color", "$value": "#000000" },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "grey": { "$type": "color", "$value": "#949494", "$description": "Borders and dividers only (3.03:1 on White). Never text." },
    "greyLight": { "$type": "color", "$value": "#EEEEEE", "$description": "Hover fills and card outlines only. Never text." },
    "tealTint8": { "$type": "color", "$value": "#EBF4F6", "$description": "Teal 8% over White. Screen only, never print. Structural, not a brand color." },
    "tealTint12": { "$type": "color", "$value": "#E1EEF1", "$description": "Teal 12% over White. Screen only, never print. Structural, not a brand color." },
    "goldenrodTint8": { "$type": "color", "$value": "#FEF9ED", "$description": "Goldenrod 8% over White. Screen only, never print. Structural, not a brand color." },
    "goldenrodTint12": { "$type": "color", "$value": "#FDF6E4", "$description": "Goldenrod 12% over White. Screen only, never print. Structural, not a brand color." },
    "mauveTint8": { "$type": "color", "$value": "#FAF3FB", "$description": "Mauve 8% over White. Screen only, never print. Structural, not a brand color." },
    "mauveTint12": { "$type": "color", "$value": "#F8EDF9", "$description": "Mauve 12% over White. Screen only, never print. Structural, not a brand color." },
    "flameTint8": { "$type": "color", "$value": "#FDF2EE", "$description": "Flame 8% over White. Screen only, never print. Structural, not a brand color." },
    "flameTint12": { "$type": "color", "$value": "#FCEBE6", "$description": "Flame 12% over White. Screen only, never print. Structural, not a brand color." }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": "Instrument Sans" },
    "serif": { "$type": "fontFamily", "$value": "Newsreader" },
    "bodyMinimum": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
  },
  "contrast": {
    "bodyMinimum": { "$type": "number", "$value": 4.5 },
    "largeTextMinimum": { "$type": "number", "$value": 3 }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "standard": { "$type": "duration", "$value": "240ms" },
    "slow": { "$type": "duration", "$value": "400ms" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "5": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
    "7": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } }
  },
  "radius": {
    "pill": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } },
    "field": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
  },
  "shadow": {
    "card": { "$type": "shadow", "$description": "Testimonial card, used with a 1px greyLight outline.", "$value": { "color": "#00000014", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
  },
  "focus": {
    "width": { "$type": "dimension", "$description": "One outline. Mauve on White (3.40:1); Black on Mauve or Flame.", "$value": { "value": 3, "unit": "px" } },
    "color": { "$type": "color", "$value": "{color.mauve}" }
  },
  "icon": {
    "size": { "$type": "dimension", "$description": "Proxima Way icons: height beside a step heading (same as space.4). Width follows the icon's shape.", "$value": { "value": 32, "unit": "px" } },
    "gap": { "$type": "dimension", "$description": "Space between an icon and its heading (same as space.2).", "$value": { "value": 16, "unit": "px" } }
  },
  "tracking": {
    "label": { "$type": "dimension", "$value": { "value": 0.04, "unit": "em" } }
  },
  "touchTarget": {
    "min": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
  },
  "breakpoint": {
    "mobile": { "$type": "dimension", "$value": { "value": 640, "unit": "px" } }
  },
  "type": {
    "desktop": {
      "displayHero": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 72, "unit": "px" }, "lineHeight": { "value": 72, "unit": "px" } } },
      "h1": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 48, "unit": "px" }, "lineHeight": { "value": 52, "unit": "px" } } },
      "h2": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 36, "unit": "px" }, "lineHeight": { "value": 40, "unit": "px" } } },
      "h3": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 24, "unit": "px" }, "lineHeight": { "value": 29, "unit": "px" } } },
      "bodyLarge": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 20, "unit": "px" }, "lineHeight": { "value": 31, "unit": "px" } } },
      "body": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 18, "unit": "px" }, "lineHeight": { "value": 29, "unit": "px" } } },
      "navButton": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 16, "unit": "px" }, "lineHeight": { "value": 19, "unit": "px" } } },
      "caption": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 14, "unit": "px" }, "lineHeight": { "value": 20, "unit": "px" } } },
      "reflectiveQuestion": { "$type": "typography", "$value": { "fontFamily": "{font.serif}", "fontSize": { "value": 38, "unit": "px" }, "lineHeight": { "value": 46, "unit": "px" } } },
      "humanQuote": { "$type": "typography", "$value": { "fontFamily": "{font.serif}", "fontSize": { "value": 28, "unit": "px" }, "lineHeight": { "value": 38, "unit": "px" } } }
    },
    "mobile": {
      "displayHero": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 40, "unit": "px" }, "lineHeight": { "value": 44, "unit": "px" } } },
      "h1": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 34, "unit": "px" }, "lineHeight": { "value": 40, "unit": "px" } } },
      "h2": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 28, "unit": "px" }, "lineHeight": { "value": 34, "unit": "px" } } },
      "h3": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 22, "unit": "px" }, "lineHeight": { "value": 28, "unit": "px" } } },
      "bodyLarge": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 18, "unit": "px" }, "lineHeight": { "value": 28, "unit": "px" } } },
      "body": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 18, "unit": "px" }, "lineHeight": { "value": 29, "unit": "px" } } },
      "navButton": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 16, "unit": "px" }, "lineHeight": { "value": 19, "unit": "px" } } },
      "caption": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 14, "unit": "px" }, "lineHeight": { "value": 20, "unit": "px" } } },
      "reflectiveQuestion": { "$type": "typography", "$value": { "fontFamily": "{font.serif}", "fontSize": { "value": 28, "unit": "px" }, "lineHeight": { "value": 36, "unit": "px" } } },
      "humanQuote": { "$type": "typography", "$value": { "fontFamily": "{font.serif}", "fontSize": { "value": 24, "unit": "px" }, "lineHeight": { "value": 32, "unit": "px" } } }
    },
    "eyebrow": {
      "$type": "typography",
      "$description": "Eyebrow label pattern (change request 0003). Eyebrows only: one per section, at most five words. Type the label in sentence case and uppercase it with CSS so screen readers read it naturally. Black on White, White on Black, or White on Teal; Teal is the only logo color that carries White text at 14px. Not for buttons, headings or navigation.",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": "SemiBold",
        "color": "{color.black}",
        "fontSize": { "value": 14, "unit": "px" },
        "lineHeight": { "value": 20, "unit": "px" },
        "letterSpacing": "{tracking.label}",
        "textTransform": "uppercase"
      }
    }
  }
}
